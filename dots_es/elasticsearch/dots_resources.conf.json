{
  "mappings": {
    "dynamic": "strict",
    "date_detection": false,
    "dynamic_templates": [
      {
        "temporal_dates": {
          "path_match": "temporal.*_iso",
          "mapping": {
            "type": "date",
            "format": "strict_date"
          }
        }
      },
      {
        "temporal_years": {
          "path_match": "temporal.*_start",
          "match_mapping_type": "long",
          "mapping": {
            "type": "integer"
          }
        }
      },
      {
        "temporal_years_end": {
          "path_match": "temporal.*_end",
          "match_mapping_type": "long",
          "mapping": {
            "type": "integer"
          }
        }
      },
      {
        "temporal_strings": {
          "path_match": "temporal.*",
          "match_mapping_type": "string",
          "mapping": {
            "type": "keyword"
          }
        }
      },
      {
        "resource_metadata_strings": {
          "path_match": "resource_metadata.*",
          "match_mapping_type": "string",
          "mapping": {
            "type": "text",
            "analyzer": "folding",
            "term_vector": "with_positions_offsets",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 256
              },
              "sort": {
                "type": "keyword",
                "normalizer": "sortable",
                "ignore_above": 256,
                "index": false
              }
            }
          }
        }
      }
    ],

    "properties": {
      "type": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "resource_id": {
        "type": "keyword"
      },

      "level": {
        "type": "integer"
      },

      "collections": {
        "type": "nested",
        "properties": {
          "collection_id": { "type": "keyword" },
          "collection_title": { "type": "keyword" },
          "path": { "type": "keyword" },
          "path_ids": { "type": "keyword" },
          "level": { "type": "integer" },
          "dublincore": {
            "type": "object",
            "dynamic": true
          }
        }
      },
      "collection_facets": {
        "type": "keyword"
      },
      "resource_metadata": {
        "type": "object",
        "dynamic": true
      },
      "temporal": {
        "type": "object",
        "dynamic": true
      }
    }
  }
}
