{
  "index" : {
    "number_of_replicas" : 0
  },
  "analysis": {
    "filter": {
      "french_elision": {
        "type": "elision",
        "articles_case": true,
        "articles": [
          "l",
          "m",
          "t",
          "qu",
          "n",
          "s",
          "j",
          "d",
          "c",
          "jusqu",
          "quoiqu",
          "lorsqu",
          "puisqu"
        ]
      }
    },
    "char_filter": {
      "html_stripper": {
        "type": "html_strip"
      },
      "strip_leading_punctuation": {
        "type": "pattern_replace",
        "pattern": "^[^\\p{L}\\p{N}]+",
        "replacement": ""
      }
    },
    "normalizer": {
      "sortable": {
        "type": "custom",
        "char_filter": [
          "strip_leading_punctuation"
        ],
        "filter": [
          "lowercase",
          "asciifolding"
        ]
      }
    },
    "normalizer": {
      "sortable": {
        "type": "custom",
        "filter": [
          "lowercase",
          "asciifolding"
        ]
      }
    },
    "analyzer": {
      "folding": {
        "tokenizer": "standard",
        "stopwords": "_french_",
        "filter": [
          "french_elision",
          "icu_folding"
        ],
        "char_filter": [
          "html_stripper"
        ]
      },
      "keyword": {
        "tokenizer": "keyword",
        "stopwords": "_french_",
        "filter": [
          "french_elision",
          "icu_folding"
        ]
      }
    }
  }
}
