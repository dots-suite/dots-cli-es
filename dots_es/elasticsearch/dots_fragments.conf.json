{
  "mappings": {
    "dynamic": "strict",
    "date_detection": false,
    "dynamic_templates": [
      {
        "fragment_temporal_dates": {
          "path_match": "fragment_temporal.*_iso",
          "mapping": {
            "type": "date",
            "format": "strict_date"
          }
        }
      },
      {
        "fragment_temporal_years": {
          "path_match": "fragment_temporal.*_start",
          "match_mapping_type": "long",
          "mapping": {
            "type": "integer"
          }
        }
      },
      {
        "fragment_temporal_years_end": {
          "path_match": "fragment_temporal.*_end",
          "match_mapping_type": "long",
          "mapping": {
            "type": "integer"
          }
        }
      },
      {
        "fragment_temporal_strings": {
          "path_match": "fragment_temporal.*",
          "match_mapping_type": "string",
          "mapping": {
            "type": "keyword"
          }
        }
      },
      {
        "fragment_metadata_strings": {
          "path_match": "fragment_metadata.*",
          "match_mapping_type": "string",
          "mapping": {
            "type": "text",
            "analyzer": "folding",
            "term_vector": "with_positions_offsets",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 256
              },
              "sort": {
                "type": "keyword",
                "normalizer": "sortable",
                "ignore_above": 256,
                "index": false
              }
            }
          }
        }
      }
    ],

    "properties": {
      "type": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "resource_id": {
        "type": "keyword"
      },

      "passage_id": {
        "type": "keyword"
      },

      "citeType": {
        "type": "keyword"
      },

      "level": {
        "type": "integer"
      },

      "title": {
        "type": "text",
        "analyzer": "folding",
        "term_vector": "with_positions_offsets"
      },

      "content": {
        "type": "text",
        "analyzer": "folding",
        "term_vector": "with_positions_offsets"
      },

      "path": {
        "type": "keyword"
      },

      "path_ids": {
        "type": "keyword"
      },

      "ancestors": {
        "type": "nested",
        "properties": {
          "id": { "type": "keyword" },
          "level": { "type": "integer" },
          "citeType": { "type": "keyword" },
          "title": { "type": "keyword" }
        }
      },

      "collection_facets": {
        "type": "keyword"
      },
      "fragment_metadata": {
        "type": "object",
        "dynamic": true
      },
      "fragment_temporal": {
        "type": "object",
        "dynamic": true
      }
    }
  }
}
